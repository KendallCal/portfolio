---
const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="
    group
    relative
    inline-flex
    h-11
    items-center
    justify-center
    gap-2
    whitespace-nowrap
    rounded-full
    bg-transparent
    px-3
    text-xs
    font-medium
    text-zinc-300
    backdrop-blur-sm
    transition-all
    duration-300
    ease-out
    hover:-translate-y-0.5
    hover:text-white
    hover:shadow-[0_4px_20px_-4px_rgba(34,211,238,0.15)]
    focus-visible:outline-none
    focus-visible:ring-2
    focus-visible:ring-cyan-500
    focus-visible:ring-offset-2
    focus-visible:ring-offset-zinc-950
    sm:h-10
    sm:px-4
    sm:text-sm
  "
  style="background-clip: padding-box;"
>
  <span
    class="
      pointer-events-none
      absolute
      inset-0
      -z-10
      rounded-full
      border border-zinc-700
      transition-all
      duration-300
      group-hover:border-transparent
    "
  ></span>
  <span
    class="
      pointer-events-none
      absolute
      inset-0
      -z-10
      rounded-full
      opacity-0
      transition-opacity
      duration-300
      group-hover:opacity-100
    "
    style="
      background: linear-gradient(#0a0a0a, #0a0a0a) padding-box,
                  rgb(34 211 238 / 0.8) border-box;
      border: 1px solid transparent;
    "
  ></span>

  <span
    class="
      flex
      items-center
      gap-2
      leading-none
      [&_svg]:h-4
      [&_svg]:w-4
      [&_svg]:shrink-0
      [&_svg]:text-zinc-400
      [&_svg]:transition-colors
      [&_svg]:duration-300
      group-hover:[&_svg]:text-cyan-400
    "
  >
    <slot />
  </span>
</a>
