---
import { Image } from "astro:assets";
import fotoKendall from "../assets/Foto.png";
import Mail from "./icons/Mail.astro";
import SocialPill from "./SocialPill.astro";
---

<section class="relative mx-auto flex min-h-[calc(100svh-4.5625rem)] w-full flex-col pt-3 lg:min-h-[calc(100vh-6rem)] lg:w-185 lg:pt-2">
  <div class="flex flex-1 flex-col justify-center gap-5 md:flex-row md:items-center md:justify-between md:gap-8">
    <div class="w-full flex-1">
      <div class="animate-fade-in-up mb-5 flex justify-center md:hidden" style="animation-delay: 0ms">
        <div class="relative">
          <div class="pointer-events-none absolute inset-0 -z-10 translate-y-4 rounded-full bg-sky-400/10 blur-2xl"></div>
          <Image
            src={fotoKendall}
            alt="Kendall Calderón"
            width={160}
            height={160}
            loading="eager"
            class="size-28 rounded-full object-cover sm:size-32"
          />
        </div>
      </div>

      <h1 class="animate-fade-in-up pb-2 text-[clamp(2.25rem,11vw,3rem)] leading-tight font-bold text-white md:text-5xl" style="animation-delay: 0ms">
        Hola, <span class="text-sky-400">soy Kendall</span>
      </h1>

      <div class="animate-fade-in-up mb-4 flex min-h-6 items-center gap-2 font-mono text-sm sm:text-base md:mb-6 md:text-lg" style="animation-delay: 120ms">
        <span class="text-sky-400" aria-hidden="true">&gt;</span>
        <span id="role-text" class="text-zinc-400">&nbsp;</span>
        <span class="terminal-cursor h-5 w-0.5 bg-sky-400" aria-hidden="true"></span>
        <span class="sr-only">Ingeniero Informático</span>
      </div>

      <p class="animate-fade-in-up mb-6 max-w-xl text-base leading-7 text-zinc-300 md:mb-8 md:text-lg md:leading-relaxed" style="animation-delay: 240ms">
        Construyo
        <span class="font-medium text-sky-400"> soluciones digitales </span>
        donde el
        <span class="font-medium" style="color: rgb(255 178 114);"> software, la computación en la nube y la inteligencia artificial </span>
        convergen para transformar
        <span class="font-medium text-zinc-100"> desafíos complejos </span>
        en experiencias
        <span class="font-medium text-sky-400"> simples, eficientes y escalables </span>.
      </p>

      <nav class="hero-socials animate-fade-in-up grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3" style="animation-delay: 360ms">
        <SocialPill href="https://www.linkedin.com/in/kendallcal/">
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
          LinkedIn
        </SocialPill>

        <SocialPill href="https://github.com/KendallCal">
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
          GitHub
        </SocialPill>

        <SocialPill href="mailto:kendallcr2012@gmail.com">
          <Mail />
          kendallcr2012@gmail.com
        </SocialPill>
      </nav>
    </div>

    <div class="animate-fade-in-up hidden flex-shrink-0 items-center justify-center md:flex" style="animation-delay: 180ms">
      <div class="relative">
        <div class="pointer-events-none absolute inset-0 -z-10 translate-y-6 rounded-full bg-sky-400/10 blur-2xl"></div>
        <Image
          src={fotoKendall}
          alt="Kendall Calderón"
          width={320}
          height={320}
          loading="lazy"
          class="h-44 w-44 rounded-full object-cover transition-all duration-300 hover:scale-[1.02]"
        />
      </div>
    </div>
  </div>

  <div class="animate-fade-in-up hidden justify-center pt-5 pb-4 md:flex md:pt-0 md:pb-2" style="animation-delay: 480ms">
    <a
      href="#projects"
      aria-label="Ir a la sección de Proyectos"
      class="bounce-scroll group inline-flex items-center gap-1.5 text-base font-semibold text-sky-400 transition-colors duration-300 hover:text-sky-300"
    >
      <span>Proyectos</span>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0l-6-6m6 6l6-6"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  @media (max-width: 639px) {
    .hero-socials :global(a) {
      width: 100%;
    }

    .hero-socials :global(a:last-child) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const ROLES = [
    "Ingeniero Informático",
    "Desarrollador de Software",
    "Cloud & Inteligencia Artificial",
  ] as const;
  const TYPE_SPEED_MS = 55;
  const DELETE_SPEED_MS = 30;
  const HOLD_MS = 1800;
  const roleEl = document.getElementById("role-text");

  const wait = (ms: number): Promise<void> =>
    new Promise((resolve) => setTimeout(resolve, ms));

  async function typeText(text: string): Promise<void> {
    if (!roleEl) return;
    for (let i = 0; i <= text.length; i++) {
      roleEl.textContent = text.slice(0, i);
      await wait(TYPE_SPEED_MS);
    }
  }

  async function deleteText(text: string): Promise<void> {
    if (!roleEl) return;
    for (let i = text.length; i >= 0; i--) {
      roleEl.textContent = text.slice(0, i);
      await wait(DELETE_SPEED_MS);
    }
  }

  async function runTypewriterLoop(): Promise<void> {
    if (!roleEl) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      roleEl.textContent = ROLES[0];
      return;
    }

    let index = 0;
    while (true) {
      const role = ROLES[index % ROLES.length];
      await typeText(role);
      await wait(HOLD_MS);
      await deleteText(role);
      index++;
    }
  }

  runTypewriterLoop();
</script>
