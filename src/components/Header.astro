---
/**
 * Header
 * Navbar principal del portafolio con soporte bilingüe (ES/EN) y menú responsive.
 */

interface NavLink {
  label: string; // Texto en español
  en: string; // Texto en inglés
  href: string; // Ancla o ruta de destino
}

const navLinks: NavLink[] = [
  { label: "Proyectos", en: "Projects", href: "/#projects" },
  { label: "Experiencia", en: "Experience", href: "/#experience" },
  { label: "Sobre mí", en: "About", href: "/#sobre-mi" },
  { label: "Contacto", en: "Contact", href: "/contact" },
];

const SOCIAL_LINKS = {
  github: "https://github.com/KendallCal",
  linkedin: "https://www.linkedin.com/in/kendallcal/",
} as const;
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2">
    <!-- Logo -->
    <a href="/" class="group flex items-center" aria-label="Ir al inicio">
      <span
        class="font-mono text-3xl font-extrabold tracking-tight text-zinc-500 transition-all duration-200 group-hover:text-zinc-300"
      >
        &lt;<span
          class="text-sky-400 "
          >K</span
        >/&gt;
      </span>
    </a>

    <!-- Navegación de escritorio -->
    <nav
      class="hidden md:flex items-center gap-1"
      aria-label="Navegación principal"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-es={link.label}
            data-en={link.en}
            class="nav-link relative px-4 py-2 text-base font-normal text-white/75 transition-colors duration-200 hover:text-white after:absolute after:bottom-0 after:left-1/2 after:h-px after:w-0 after:bg-sky-400 after:transition-all after:duration-300 after:-translate-x-1/2 hover:after:w-4/5"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Acciones: redes sociales + toggle de idioma -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center rounded-lg p-2 text-white/50 transition-colors duration-200 hover:text-sky-400"
        title="GitHub"
        aria-label="Perfil de GitHub"
      >
        <svg
          class="h-5 w-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
      </a>

      <a
        href={SOCIAL_LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center rounded-lg p-2 text-white/50 transition-colors duration-200 hover:text-sky-400"
        title="LinkedIn"
        aria-label="Perfil de LinkedIn"
      >
        <svg
          class="h-5 w-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>

      <div class="h-5 w-px bg-white/10" aria-hidden="true"></div>

      <button
        id="lang-toggle"
        class="inline-flex h-8.5 cursor-pointer items-center justify-center rounded-lg border border-white/10 bg-white/5 px-3 text-sm leading-none font-normal text-white/50 transition-all duration-200 hover:border-sky-400/50 hover:bg-sky-400/10 hover:text-sky-400 active:scale-95"
        data-lang="es"
        aria-label="Cambiar idioma"
      >
        ES
      </button>
    </div>

    <!-- Botón de menú móvil -->
    <button
      id="menu-toggle"
      class="flex md:hidden items-center justify-center rounded-lg p-2 text-white/50 hover:text-white"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Menú móvil -->
<div
  id="mobile-menu"
  class="fixed top-18.25 left-0 right-0 z-40 hidden flex-col gap-1 border-b border-white/5 bg-zinc-950/95 px-6 py-4 backdrop-blur-md"
>
  {
    navLinks.map((link) => (
      <a
        href={link.href}
        data-es={link.label}
        data-en={link.en}
        class="nav-link py-2.5 text-base font-normal text-white/60 transition-colors hover:text-white"
      >
        {link.label}
      </a>
    ))
  }
  <div class="mt-3 flex items-center gap-3 border-t border-white/5 pt-3">
    <button
      id="lang-toggle-mobile"
      data-lang="es"
      class="inline-flex h-8.5 cursor-pointer items-center justify-center rounded-md border border-white/10 px-3 text-sm leading-none font-normal text-white/60 transition-all hover:border-sky-400/50 hover:text-sky-400 active:scale-95"
      aria-label="Cambiar idioma"
    >
      ES
    </button>
  </div>
</div>

<!-- Spacer para compensar el header fixed -->
<div class="h-18.25" aria-hidden="true"></div>

<script>
  // ============================================================
  // Tipos y constantes
  // ============================================================
  type Lang = "es" | "en";

  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const langToggleDesktop = document.getElementById("lang-toggle");
  const langToggleMobile = document.getElementById("lang-toggle-mobile");

  let currentLang: Lang = "es";

  // ============================================================
  // Menú móvil: abrir / cerrar
  // ============================================================
  function toggleMobileMenu(): void {
    if (!menuToggle || !mobileMenu) return;

    const isOpen = mobileMenu.classList.toggle("hidden") === false;
    mobileMenu.classList.toggle("flex", isOpen);
    menuToggle.setAttribute("aria-expanded", String(isOpen));
  }

  menuToggle?.addEventListener("click", toggleMobileMenu);

  // ============================================================
  // Idioma: alternar entre ES / EN
  // ============================================================
  // Traduce CUALQUIER elemento de la página que tenga data-es/data-en,
  // no solo el nav. Así cada sección (Hero, Experience, Projects, etc.)
  // se suma al toggle global con solo agregar esos dos atributos.
  function updateAllTranslatableText(lang: Lang): void {
    const isEs = lang === "es";

    document
      .querySelectorAll<HTMLElement>("[data-es][data-en]")
      .forEach((el) => {
        const label = isEs ? el.dataset.es : el.dataset.en;
        if (label) el.textContent = label;
      });

    document.documentElement.lang = lang;
  }

  function updateLangButtons(lang: Lang): void {
    const nextLabel = lang === "es" ? "EN" : "ES";

    [langToggleDesktop, langToggleMobile].forEach((btn) => {
      if (!btn) return;
      btn.textContent = nextLabel;
      btn.setAttribute("data-lang", lang);
    });
  }

  function setLang(lang: Lang): void {
    currentLang = lang;
    updateAllTranslatableText(lang);
    updateLangButtons(lang);
    localStorage.setItem("lang", lang);
  }

  function toggleLang(): void {
    setLang(currentLang === "es" ? "en" : "es");
  }

  langToggleDesktop?.addEventListener("click", toggleLang);
  langToggleMobile?.addEventListener("click", toggleLang);

  // Al cargar, respeta el idioma que el usuario eligió la última vez
  const savedLang = localStorage.getItem("lang") as Lang | null;
  if (savedLang === "en") setLang("en");
</script>
