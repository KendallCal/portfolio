---
/* Sistema de idiomas */
import type { Language } from "../i18n/config";
import { getTranslations } from "../i18n/utils";

/* Propiedades que puede recibir el componente */
interface Props {
  language?: Language;
}

/* Idioma actual y traducciones correspondientes */
const { language = "es" } = Astro.props;
const t = getTranslations(language);

/* Calcula el tiempo transcurrido desde una fecha de inicio */
function calcYears(startDate: string, endDate?: string): string {
  const start = new Date(startDate);
  const end = endDate ? new Date(endDate) : new Date();

  const months =
    (end.getFullYear() - start.getFullYear()) * 12 +
    (end.getMonth() - start.getMonth());

  const years = Math.floor(months / 12);
  const rem = months % 12;

  const yearLabel =
    years === 1 ? t.experience.year : t.experience.years;

  const monthLabel =
    rem === 1 ? t.experience.month : t.experience.months;

  if (years === 0) return `${rem} ${monthLabel}`;
  if (rem === 0) return `${years} ${yearLabel}`;

  return `${years} ${yearLabel} ${rem} ${monthLabel}`;
}

/* Experiencias profesionales mostradas en la línea de tiempo */
const experiences = [
  {
    ...t.experience.items[0],
    startDate: "2025-01-01",
  },
  {
    ...t.experience.items[1],
    startDate: "2021-11-01",
  },
];
---

<section class="w-full scroll-mt-24" id="experience">
  <!-- Título de la sección -->
  <h2 class="text-2xl font-bold text-white sm:text-3xl">
    {t.experience.title}
  </h2>

  <!-- Línea de tiempo de experiencia -->
  <article class="mt-8 px-3 sm:mt-10 sm:px-2">
    <ul class="relative border-l border-zinc-700">
      {
        experiences.map((exp) => (
          <li class="mb-8 ml-7 last:mb-0 sm:ml-6 md:mb-6">
            <!-- Indicador de la experiencia -->
            <span class="absolute -left-3 flex h-6 w-6 items-center justify-center rounded-full bg-zinc-700">
              <svg
                aria-hidden="true"
                class="h-4 w-4 text-zinc-300"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z"
                />
                <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z" />
              </svg>
            </span>

            <!-- Puesto y empresa -->
            <h3 class="mb-1 flex flex-col items-start gap-0.5 text-base leading-6 font-semibold text-sky-400 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2 sm:gap-y-1 sm:text-lg">
              <span>{exp.role}</span>

              <span class="hidden font-normal text-white sm:inline">
                -
              </span>

              <span class="block text-sm font-semibold text-orange-300">
                {exp.company}
              </span>
            </h3>

            <!-- Fecha y duración -->
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <time class="text-sm text-zinc-400">
                {exp.date}
              </time>

              <span class="rounded-full bg-sky-400/10 px-2 py-0.5 text-xs font-medium text-sky-400">
                {calcYears(exp.startDate)}
              </span>
            </div>

            <!-- Descripción de la experiencia -->
            <p class="max-w-2xl text-pretty text-sm leading-7 text-zinc-300 sm:text-base sm:leading-relaxed">
              {exp.description}
            </p>
          </li>
        ))
      }
    </ul>
  </article>
</section>