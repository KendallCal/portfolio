---
/* Imagen del perfil */
import { Image } from "astro:assets";
import fotoKendall from "../assets/Foto.webp";

/* Sistema de idiomas y rutas localizadas */
import type { Language } from "../i18n/config";
import { getTranslations, localizePath } from "../i18n/utils";

/* Propiedades que puede recibir el componente */
interface Props {
  language?: Language;
}

/* Idioma actual y traducciones correspondientes */
const { language = "es" } = Astro.props;
const t = getTranslations(language);

/* Cualidades profesionales mostradas en la sección */
const qualities = [
  {
    label: t.homeAbout.qualities[0],
    icon: "M13 2 3 14h9l-1 8 10-12h-9l1-8z",
  },
  {
    label: t.homeAbout.qualities[1],
    icon: "M22 12h-4l-3 9L9 3l-3 9H2",
  },
  {
    label: t.homeAbout.qualities[2],
    icon: "shield",
  },
];
---

<section class="w-full scroll-mt-24" id="sobre-mi">
  <!-- Título de la sección -->
  <div class="mb-7 sm:mb-10">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
      {t.homeAbout.title}
    </h2>
  </div>

  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-14">
    <!-- Fotografía personal -->
    <div class="shrink-0 self-center lg:self-auto">
      <div class="relative">
        <div
          class="pointer-events-none absolute inset-0 -z-10 translate-y-6 rounded-full bg-sky-400/10 blur-2xl"
        >
        </div>

        <Image
          src={fotoKendall}
          alt="Kendall Calderón"
          width={180}
          height={180}
          class="h-36 w-36 rounded-full object-cover transition-transform duration-500 hover:scale-[1.03] motion-reduce:transition-none motion-reduce:hover:scale-100"
        />
      </div>
    </div>

    <!-- Presentación y cualidades profesionales -->
    <div class="space-y-6">
      <div class="space-y-4 text-base leading-relaxed text-zinc-300">
        <p>
          {t.homeAbout.paragraphs[0]}
          <span class="text-white">{t.homeAbout.paragraphs[1]}</span>
          {t.homeAbout.paragraphs[2]}
        </p>

        <p>
          {t.homeAbout.paragraphs[3]}
        </p>
      </div>

      <!-- Cualidades mostradas en pantallas medianas y grandes -->
      <div
        class="hidden gap-2 sm:grid sm:grid-cols-3 sm:gap-3 lg:flex lg:flex-nowrap lg:items-center lg:gap-5"
      >
        {
          qualities.map((quality, index) => (
            <div class="group flex min-h-11 items-center gap-2 text-sm text-zinc-400 transition-colors duration-300 hover:text-zinc-200 lg:shrink-0">
              <svg
                class="quality-icon size-4.5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                style={`animation-delay: ${index * 0.55}s;`}
                aria-hidden="true"
              >
                {quality.icon === "shield" ? (
                  <>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 21s7-3.5 7-9V6l-7-3-7 3v6c0 5.5 7 9 7 9z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m9.5 12 1.8 1.8 3.2-3.6"
                    />
                  </>
                ) : (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={quality.icon}
                  />
                )}
              </svg>

              <span class="font-medium text-zinc-300">{quality.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Enlace al perfil completo -->
  <div class="mt-6 flex justify-center sm:mt-10">
    <a
      href={localizePath("/about", language)}
      aria-label={t.homeAbout.fullProfileAria}
      class="group inline-flex h-11 items-center gap-2.5 rounded-full border border-sky-400/30 bg-sky-400/10 px-6 text-sm font-semibold text-sky-300 shadow-sm shadow-black/20 transition-all duration-300 ease-out hover:border-sky-400 hover:bg-sky-400 hover:text-zinc-950 hover:shadow-lg hover:shadow-sky-400/25 focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 focus-visible:outline-none active:scale-[0.97] motion-reduce:transition-none motion-reduce:active:scale-100"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="8" r="4"></circle>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
      </svg>

      {t.homeAbout.fullProfile}
    </a>
  </div>
</section>

<style>
  /* Animación de color de los iconos */
  .quality-icon {
    filter: drop-shadow(0 0 4px rgb(56 189 248 / 0.35));
    animation: quality-color-cycle 5.5s ease-in-out infinite;
    transition: filter 300ms ease;
  }

  /* Resalta el icono al pasar el cursor */
  .group:hover .quality-icon {
    filter: drop-shadow(0 0 10px currentColor)
      drop-shadow(0 0 18px currentColor);
    animation-play-state: paused;
  }

  @keyframes quality-color-cycle {
    0%,
    100% {
      color: rgb(56 189 248);
      opacity: 0.85;
    }

    25% {
      color: rgb(129 140 248);
      opacity: 1;
    }

    50% {
      color: rgb(34 211 238);
      opacity: 0.9;
    }

    75% {
      color: #fcb669;
      opacity: 1;
    }
  }

  /* Desactiva la animación cuando se prefieren menos movimientos */
  @media (prefers-reduced-motion: reduce) {
    .quality-icon {
      animation: none;
      opacity: 1;
    }
  }
</style>
