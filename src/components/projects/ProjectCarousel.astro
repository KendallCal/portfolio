---
import type { Project } from "../../data/projects";
import ChevronLeft from "../icons/Carousel-Chevron-Left.astro";
import ChevronRight from "../icons/Carousel-Chevron-Right.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const hasControls = projects.length > 2;
---

{
  hasControls ? (
    <div
      class="relative mt-10"
      data-project-carousel
      aria-roledescription="carrusel"
      aria-label="Proyectos destacados"
    >
      <div class="overflow-hidden" data-carousel-viewport>
        <div
          class="flex will-change-transform motion-reduce:transition-none"
          data-carousel-track
        >
          {projects.map((project) => (
            <div class="w-full shrink-0 px-2.5 sm:w-1/2 sm:px-3">
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </div>

      <button
        type="button"
        class="carousel-control absolute top-1/2 -left-8 z-40 -translate-y-1/2"
        data-carousel-previous
        aria-label="Mostrar proyectos anteriores"
      >
        <span class="[&_svg]:h-8 [&_svg]:w-4" aria-hidden="true">
          <ChevronLeft />
        </span>
      </button>

      <button
        type="button"
        class="carousel-control absolute top-1/2 -right-8 z-40 -translate-y-1/2"
        data-carousel-next
        aria-label="Mostrar proyectos siguientes"
      >
        <span class="[&_svg]:h-8 [&_svg]:w-4" aria-hidden="true">
          <ChevronRight />
        </span>
      </button>
    </div>
  ) : (
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  )
}

<style>
  [data-carousel-track] {
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-control {
    display: inline-flex;
    width: 2.75rem;
    height: 4rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: rgb(161 161 170);
    transition:
      color 200ms ease,
      transform 200ms ease;
  }

  .carousel-control:hover:not(:disabled) {
    color: rgb(14 165 233);
  }

  .carousel-control:focus-visible {
    outline: 2px solid rgb(56 189 248 / 0.65);
    outline-offset: 3px;
  }

  .carousel-control:disabled {
    cursor: default;
    opacity: 0.25;
  }

  @media (max-width: 639px) {
    .carousel-control:first-of-type {
      left: 0.75rem;
      transform: translateY(-50%);
    }

    .carousel-control:last-of-type {
      right: 0.75rem;
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-carousel-track] {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach(
    (carousel) => {
      const viewport = carousel.querySelector<HTMLElement>(
        "[data-carousel-viewport]",
      );
      const track = carousel.querySelector<HTMLElement>(
        "[data-carousel-track]",
      );
      const slides = Array.from(track?.children ?? []);
      const previous = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-previous]",
      );
      const next = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );

      if (!viewport || !track || !previous || !next) return;

      let currentIndex = 0;

      const visibleSlides = () =>
        window.matchMedia("(min-width: 640px)").matches ? 2 : 1;

      const update = () => {
        const visible = visibleSlides();
        const maxIndex = Math.max(0, slides.length - visible);
        currentIndex = Math.min(currentIndex, maxIndex);
        const step = viewport.clientWidth / visible;

        track.style.transform = `translate3d(${-currentIndex * step}px, 0, 0)`;
        previous.disabled = currentIndex === 0;
        next.disabled = currentIndex === maxIndex;
      };

      previous.addEventListener("click", () => {
        currentIndex = Math.max(0, currentIndex - 1);
        update();
      });

      next.addEventListener("click", () => {
        const maxIndex = Math.max(0, slides.length - visibleSlides());
        currentIndex = Math.min(maxIndex, currentIndex + 1);
        update();
      });

      const resizeObserver = new ResizeObserver(update);
      resizeObserver.observe(viewport);
      update();
    },
  );
</script>
