---
import type { Project } from "../../data/projects";
import ChevronLeft from "../icons/Carousel-Chevron-Left.astro";
import ChevronRight from "../icons/Carousel-Chevron-Right.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const hasControls = projects.length > 2;
---

{
  hasControls ? (
    <div
      class="relative mt-10"
      data-project-carousel
      aria-roledescription="carrusel"
      aria-label="Proyectos destacados"
    >
      <div class="overflow-hidden" data-carousel-viewport>
        <div
          class="flex will-change-transform motion-reduce:transition-none"
          data-carousel-track
        >
          {projects.map((project) => (
            <div class="w-full shrink-0 sm:w-1/2 sm:px-3">
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </div>

      <button
        type="button"
        class="carousel-control absolute top-1/2 left-3 z-40 hidden -translate-y-1/2 sm:inline-flex sm:left-0 lg:-left-8"
        data-carousel-previous
        aria-label="Mostrar proyectos anteriores"
      >
        <span class="[&_svg]:h-8 [&_svg]:w-4" aria-hidden="true">
          <ChevronLeft />
        </span>
      </button>

      <button
        type="button"
        class="carousel-control absolute top-1/2 right-3 z-40 hidden -translate-y-1/2 sm:inline-flex sm:right-0 lg:-right-8"
        data-carousel-next
        aria-label="Mostrar proyectos siguientes"
      >
        <span class="[&_svg]:h-8 [&_svg]:w-4" aria-hidden="true">
          <ChevronRight />
        </span>
      </button>
    </div>
  ) : (
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  )
}

<style>
  [data-carousel-track] {
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-control {
    width: 2.75rem;
    height: 4rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: rgb(161 161 170);
    transition:
      color 200ms ease,
      transform 200ms ease;
  }

  .carousel-control:hover:not(:disabled) {
    color: rgb(14 165 233);
  }

  .carousel-control:focus-visible {
    outline: 2px solid rgb(56 189 248 / 0.65);
    outline-offset: 3px;
  }

  .carousel-control:disabled {
    cursor: default;
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-carousel-track] {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach(
    (carousel) => {
      const viewport = carousel.querySelector<HTMLElement>(
        "[data-carousel-viewport]",
      );
      const track = carousel.querySelector<HTMLElement>(
        "[data-carousel-track]",
      );
      const slides = Array.from(track?.children ?? []);
      const previous = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-previous]",
      );
      const next = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );

      if (!viewport || !track) return;

      let currentIndex = 0;
      let autoplayTimer: number | undefined;
      let touchStartX = 0;
      let touchDeltaX = 0;
      const AUTOPLAY_DELAY_MS = 5200;

      const visibleSlides = () =>
        window.matchMedia("(min-width: 640px)").matches ? 2 : 1;

      const update = () => {
        const visible = visibleSlides();
        const maxIndex = Math.max(0, slides.length - visible);
        currentIndex = Math.min(currentIndex, maxIndex);
        const step = viewport.clientWidth / visible;

        track.style.transform = `translate3d(${-currentIndex * step}px, 0, 0)`;
        if (previous) previous.disabled = currentIndex === 0;
        if (next) next.disabled = currentIndex === maxIndex;
      };

      previous?.addEventListener("click", () => {
        currentIndex = Math.max(0, currentIndex - 1);
        update();
      });

      next?.addEventListener("click", () => {
        const maxIndex = Math.max(0, slides.length - visibleSlides());
        currentIndex = Math.min(maxIndex, currentIndex + 1);
        update();
      });

      const stopAutoplay = () => {
        if (autoplayTimer !== undefined) window.clearInterval(autoplayTimer);
        autoplayTimer = undefined;
      };

      const startAutoplay = () => {
        stopAutoplay();
        const isMobile = window.matchMedia("(max-width: 639px)").matches;
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (!isMobile || reduceMotion || slides.length < 2) return;

        autoplayTimer = window.setInterval(() => {
          currentIndex = (currentIndex + 1) % slides.length;
          update();
        }, AUTOPLAY_DELAY_MS);
      };

      viewport.addEventListener(
        "touchstart",
        (event) => {
          touchStartX = event.touches[0]?.clientX ?? 0;
          touchDeltaX = 0;
          stopAutoplay();
        },
        { passive: true },
      );

      viewport.addEventListener(
        "touchmove",
        (event) => {
          touchDeltaX = (event.touches[0]?.clientX ?? touchStartX) - touchStartX;
        },
        { passive: true },
      );

      viewport.addEventListener("touchend", () => {
        if (Math.abs(touchDeltaX) >= 45) {
          const maxIndex = Math.max(0, slides.length - visibleSlides());
          currentIndex =
            touchDeltaX < 0
              ? Math.min(maxIndex, currentIndex + 1)
              : Math.max(0, currentIndex - 1);
          update();
        }
        startAutoplay();
      });

      const resizeObserver = new ResizeObserver(update);
      resizeObserver.observe(viewport);
      update();
      startAutoplay();
      window.addEventListener("resize", startAutoplay);
    },
  );
</script>
