---
import { Image } from "astro:assets";
import type { Project } from "../../data/projects";
import TechBadge from "./TechBadge.astro";
import GitHubIcon from "../icons/GitHub.astro";

interface Props {
  project: Project;
  index?: number;
}

const { project } = Astro.props;
const searchIndex = [
  project.title,
  project.shortDesc,
  project.categoryLabel,
  ...project.techs.map((tech) => tech.name),
].join(" ").toLowerCase();

const actionButtonClass = "inline-flex h-8 w-8 items-center justify-center rounded-md text-zinc-400 transition-colors duration-200 hover:text-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/50 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 active:scale-[0.98] motion-reduce:transform-none motion-reduce:transition-none";
---

<article
  data-project-card
  data-category={project.category}
  data-search={searchIndex}
  class="group project-card relative flex h-[400px] flex-col overflow-hidden rounded-2xl border border-zinc-800/90 bg-zinc-900/95 shadow-sm shadow-black/20 transition-colors duration-300 motion-reduce:transition-none"
>
  <svg
    class="snake-border pointer-events-none absolute inset-0 z-30 h-full w-full opacity-0 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none"
    aria-hidden="true"
  >
    <rect
      class="snake-border-rect"
      x="1"
      y="1"
      width="calc(100% - 2px)"
      height="calc(100% - 2px)"
      rx="15"
      ry="15"
      fill="none"
      stroke="rgb(56 189 248)"
      stroke-width="1"
      stroke-linecap="round"
      pathLength="100"
      stroke-dasharray="16 84"
      stroke-dashoffset="0"
    >
      <animate
        attributeName="stroke-dashoffset"
        from="0"
        to="-100"
        dur="12s"
        begin="0s"
        calcMode="linear"
        repeatCount="indefinite"
      />
    </rect>
  </svg>

  <a
    href={`/projects/${project.slug}`}
    class="relative z-10 block aspect-video overflow-hidden bg-zinc-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/50 focus-visible:ring-inset"
  >
    {project.image
      ? <Image
          src={project.image}
          alt={project.title}
          class="h-full w-full object-cover transition-[filter,transform] duration-300 group-hover:scale-[1.01] group-hover:blur-[2px] motion-reduce:transition-none"
          loading="lazy"
        />
      : <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-zinc-800 to-zinc-900">
          <svg class="h-12 w-12 text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
    }

    <div class="absolute inset-0 flex items-center justify-center bg-black/45 opacity-0 backdrop-blur-[1px] transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none">
      <span class="inline-flex items-center rounded-full border border-zinc-700 bg-zinc-950/85 px-4 py-2 text-sm font-medium text-white/95 transition-colors duration-200 hover:border-sky-400/60 hover:text-sky-400">
        Ver proyecto
      </span>
    </div>
  </a>

  <div class="relative z-10 flex flex-1 flex-col gap-3.5 p-5">
    <div class="flex items-center justify-between gap-3">
      <a
        href={`/projects/${project.slug}`}
        class="group/title inline-block min-w-0 truncate rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/50 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
      >
        <h3 class="truncate text-lg font-semibold leading-6 text-white transition-colors group-hover/title:text-sky-400">
          {project.title}
        </h3>
      </a>

      <div class="flex shrink-0 items-center gap-2">
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={actionButtonClass}
            title="Ver repositorio en GitHub"
            aria-label="Ver repositorio en GitHub"
          >
            <GitHubIcon class="h-[1.15rem] w-[1.15rem]" />
          </a>
        )}
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={actionButtonClass}
            title="Abrir proyecto"
            aria-label="Abrir proyecto"
          >
            <svg class="h-[1.15rem] w-[1.15rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M15 3h6v6" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M10 14 21 3" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <p class="line-clamp-3 text-sm leading-6 text-zinc-400">
      {project.shortDesc}
    </p>

    {project.techs.length > 0 && (
      <div class="mt-auto flex flex-wrap items-center justify-center gap-2 border-t border-zinc-800/70 pt-3">
        {project.techs.map((tech) => (
          <TechBadge tech={tech} />
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .project-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(63, 63, 70, 0.35);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .snake-border-rect animate {
      display: none;
    }
  }
</style>
