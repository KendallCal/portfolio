---
/* Datos y utilidades de los proyectos */
import { getProjects } from "../../data/projects";

/* Sistema de idiomas y rutas localizadas */
import type { Language } from "../../i18n/config";
import {
  getTranslations,
  localizePath,
} from "../../i18n/utils";

/* Componentes utilizados por la sección */
import ArrowRight from "../icons/Arrow-Right.astro";
import ProjectCarousel from "./ProjectCarousel.astro";
import ProjectCard from "./ProjectCard.astro";

/* Propiedades que puede recibir el componente */
interface Props {
  variant?: "featured" | "all";
  title?: string;
  description?: string;
  headingLevel?: "h1" | "h2";
  showAllLink?: boolean;
  language?: Language;
}

/* Configuración actual de la sección */
const {
  variant = "featured",
  headingLevel = "h2",
  showAllLink = variant === "featured",
  language = "es",
} = Astro.props;

/* Traducciones y textos principales */
const t = getTranslations(language);
const title = Astro.props.title ?? t.projects.title;
const description =
  Astro.props.description ?? t.projects.description;

/* Proyectos disponibles en el idioma actual */
const projects = getProjects(language);

/* Filtra los proyectos según la variante seleccionada */
const visibleProjects =
  variant === "all"
    ? projects
    : projects.filter((project) => project.featured);

/* Nivel de encabezado utilizado por la sección */
const Heading = headingLevel;

/* Parte de la descripción que recibe mayor énfasis */
const highlightedDescription = t.projects.highlighted;
const descriptionParts =
  description.split(highlightedDescription);
---

<!-- Sección principal de proyectos -->
<section
  class="w-full scroll-mt-24"
  id="projects"
>
  <!-- Título de la sección -->
  <Heading
    class:list={[
      "font-bold text-white",
      headingLevel === "h1"
        ? "text-center text-4xl sm:text-5xl"
        : "text-3xl",
    ]}
  >
    {title}
  </Heading>

  <!-- Descripción de la sección -->
  <p
    class:list={[
      "mt-2 leading-relaxed text-zinc-400",
      headingLevel === "h1" &&
        "w-full text-center text-base sm:text-lg",
    ]}
  >
    {
      descriptionParts.length === 2 ? (
        <>
          {descriptionParts[0]}

          <span class="text-zinc-300">
            {highlightedDescription}
          </span>

          {descriptionParts[1]}
        </>
      ) : (
        description
      )
    }
  </p>

  {
    visibleProjects.length === 0 ? (
      <div
        class="mt-10 flex flex-col items-center justify-center rounded-2xl border border-dashed border-zinc-700 bg-zinc-900/40 py-20 text-center"
      >
        <svg
          class="h-10 w-10 text-zinc-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          />
        </svg>

        <p class="mt-4 text-sm text-zinc-600">
          {t.projects.empty}
        </p>
      </div>
    ) : variant === "featured" ? (
      <ProjectCarousel
        projects={visibleProjects}
        language={language}
      />
    ) : (
      <div
        class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      >
        {visibleProjects.map((project) => (
          <ProjectCard
            project={project}
            language={language}
          />
        ))}
      </div>
    )
  }

  {
    showAllLink && projects.length > 0 && (
      <div class="mt-8 flex justify-center">
        <a
          href={localizePath("/projects", language)}
          class="group inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition-colors duration-300 ease-out hover:text-white focus-visible:ring-2 focus-visible:ring-sky-400/50 focus-visible:outline-none"
        >
          <span
            class="relative after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:origin-center after:scale-x-0 after:bg-sky-400/70 after:transition-transform after:duration-300 after:ease-out group-hover:after:scale-x-100"
          >
            {t.projects.viewAll}
          </span>

          <span
            class="text-sky-400 transition-transform duration-300 ease-out group-hover:translate-x-0.5 motion-reduce:transform-none [&_svg]:size-4"
            aria-hidden="true"
          >
            <ArrowRight />
          </span>
        </a>
      </div>
    )
  }
</section>