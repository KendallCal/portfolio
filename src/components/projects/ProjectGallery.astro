---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ProjectMedia } from "../../data/projects";
import CarouselChevronLeft from "../icons/Carousel-Chevron-Left.astro";
import CarouselChevronRight from "../icons/Carousel-Chevron-Right.astro";

interface Props {
  title: string;
  image: ImageMetadata;
  media?: ProjectMedia[];
}

const { title, image, media = [] } = Astro.props;

type Slide =
  | { type: "image"; image: ImageMetadata; alt: string }
  | { type: "youtube"; videoId: string; title: string };

// The cover image always leads the gallery; anything in `media` follows it.
const slides: Slide[] = [{ type: "image", image, alt: `Vista principal de ${title}` }, ...media];
const hasMultiple = slides.length > 1;
---

<div class="relative" data-gallery>
  <div
    class="relative overflow-visible rounded-xl border border-zinc-800/80 bg-[#0B0C13] shadow-[0_24px_60px_-32px_rgba(0,0,0,0.75)] outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
    tabindex={hasMultiple ? "0" : undefined}
    aria-roledescription={hasMultiple ? "carrusel" : undefined}
    aria-label={hasMultiple ? `Galería de ${title}, usa las flechas del teclado para navegar` : undefined}
    data-gallery-frame
  >
    <div class="relative aspect-video w-full overflow-hidden rounded-[0.7rem] bg-zinc-900" data-gallery-viewport>
      <div class="flex h-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none" data-gallery-track>
        {slides.map((slide, index) => (
          <div
            class="h-full w-full flex-none"
            data-gallery-slide
          >
            {slide.type === "image" ? (
              <Image
                src={slide.image}
                alt={slide.alt}
                class="h-full w-full object-cover"
                widths={[480, 768, 1080, 1440]}
                sizes="(max-width: 768px) 100vw, 768px"
                loading={index === 0 ? "eager" : "lazy"}
              />
            ) : (
              <div class="relative h-full w-full bg-black" data-youtube-slot data-video-id={slide.videoId} data-video-title={slide.title}>
                <img
                  src={`https://img.youtube.com/vi/${slide.videoId}/hqdefault.jpg`}
                  alt={slide.title}
                  class="h-full w-full object-cover opacity-70"
                  loading="lazy"
                />
                <button
                  type="button"
                  data-play-video
                  aria-label={`Reproducir video: ${slide.title}`}
                  class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors duration-300 hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
                >
                  <span class="flex size-16 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm transition-transform duration-300 hover:scale-110">
                    <svg class="ml-1 size-6 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7Z" />
                    </svg>
                  </span>
                </button>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    {hasMultiple && (
      <>
        <button
          type="button"
          data-gallery-prev
          aria-label="Diapositiva anterior"
          class="absolute left-2 top-1/2 z-20 flex h-14 w-8 -translate-y-1/2 cursor-pointer items-center justify-center text-zinc-300 drop-shadow-[0_0_8px_rgba(0,0,0,0.9)] transition-all duration-200 hover:text-[var(--project-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 sm:-left-10 [&_svg]:h-10 [&_svg]:w-5"
        >
          <CarouselChevronLeft />
        </button>
        <button
          type="button"
          data-gallery-next
          aria-label="Siguiente diapositiva"
          class="absolute right-2 top-1/2 z-20 flex h-14 w-8 -translate-y-1/2 cursor-pointer items-center justify-center text-zinc-300 drop-shadow-[0_0_8px_rgba(0,0,0,0.9)] transition-all duration-200 hover:text-[var(--project-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 sm:-right-10 [&_svg]:h-10 [&_svg]:w-5"
        >
          <CarouselChevronRight />
        </button>

        <div
          class="absolute bottom-3 right-3 rounded-full border border-white/10 bg-zinc-950/70 px-2.5 py-1 font-mono text-[11px] tabular-nums text-zinc-300 backdrop-blur-sm"
          data-gallery-counter
          aria-live="polite"
        >
          1 / {slides.length}
        </div>
      </>
    )}
  </div>

</div>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  if (gallery) {
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    const frame = gallery.querySelector<HTMLElement>("[data-gallery-frame]");
    const viewport = gallery.querySelector<HTMLElement>("[data-gallery-viewport]");
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const prevBtn = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const nextBtn = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const total = slides.length;
    let current = 0;

    function render() {
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      if (counter) counter.textContent = `${current + 1} / ${total}`;
    }

    function goTo(index: number) {
      current = (index + total) % total;
      render();
    }

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));
    frame?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goTo(current - 1);
      if (event.key === "ArrowRight") goTo(current + 1);
    });

    let touchStartX = 0;
    viewport?.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.touches[0].clientX;
      },
      { passive: true },
    );
    viewport?.addEventListener(
      "touchend",
      (event) => {
        const delta = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 40) goTo(current + (delta < 0 ? 1 : -1));
      },
      { passive: true },
    );

    gallery.querySelectorAll<HTMLButtonElement>("[data-play-video]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slot = btn.closest<HTMLElement>("[data-youtube-slot]");
        if (!slot) return;
        const videoId = slot.dataset.videoId;
        const title = slot.dataset.videoTitle ?? "Video del proyecto";
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.title = title;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.className = "h-full w-full";
        slot.replaceChildren(iframe);
      });
    });
  }
</script>
