---
/* Componente para optimizar imágenes */
import { Image } from "astro:assets";

/* Tipos utilizados por la galería */
import type { ImageMetadata } from "astro";
import type { ProjectMedia } from "../../data/projects";

/* Controles de navegación */
import CarouselChevronLeft from "../icons/Carousel-Chevron-Left.astro";
import CarouselChevronRight from "../icons/Carousel-Chevron-Right.astro";

/* Sistema de idiomas */
import type { Language } from "../../i18n/config";
import { getTranslations } from "../../i18n/utils";

/* Propiedades que recibe el componente */
interface Props {
  title: string;
  image: ImageMetadata;
  media?: ProjectMedia[];
  language?: Language;
}

/* Información actual de la galería */
const {
  title,
  image,
  media = [],
  language = "es",
} = Astro.props;

const t = getTranslations(language);

/* Tipos de contenido admitidos por la galería */
type Slide =
  | {
      type: "image";
      image: ImageMetadata;
      alt: string;
    }
  | {
      type: "youtube";
      videoId: string;
      title: string;
    };

/* La imagen principal siempre aparece primero */
const slides: Slide[] = [
  {
    type: "image",
    image,
    alt: `${t.detail.galleryMain} ${title}`,
  },
  ...media,
];

/* Indica si deben mostrarse los controles del carrusel */
const hasMultiple = slides.length > 1;
---

<!-- Galería principal del proyecto -->
<div
  class="relative"
  data-gallery
  data-fallback-video-title={t.detail.fallbackVideo}
>
  <!-- Marco de la galería -->
  <div
    class="relative overflow-visible rounded-xl border border-zinc-800/80 bg-[#0B0C13] shadow-[0_24px_60px_-32px_rgba(0,0,0,0.75)] outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
    tabindex={hasMultiple ? "0" : undefined}
    aria-roledescription={hasMultiple ? t.projects.carouselRole : undefined}
    aria-label={hasMultiple
      ? t.detail.galleryLabel.replace("{title}", title)
      : undefined}
    data-gallery-frame
  >
    <!-- Área visible del carrusel -->
    <div
      class="relative aspect-video w-full overflow-hidden rounded-[0.7rem] bg-zinc-900"
      data-gallery-viewport
    >
      <!-- Contenedor móvil de las diapositivas -->
      <div
        class="flex h-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none"
        data-gallery-track
      >
        {
          slides.map((slide, index) => (
            <div
              class="h-full w-full flex-none"
              data-gallery-slide
            >
              {slide.type === "image" ? (
                <Image
                  src={slide.image}
                  alt={slide.alt}
                  class="h-full w-full object-cover"
                  widths={[480, 768, 1080, 1440]}
                  sizes="(max-width: 768px) 100vw, 768px"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              ) : (
                <div
                  class="relative h-full w-full bg-black"
                  data-youtube-slot
                  data-video-id={slide.videoId}
                  data-video-title={slide.title}
                >
                  <!-- Miniatura del video -->
                  <img
                    src={`https://img.youtube.com/vi/${slide.videoId}/hqdefault.jpg`}
                    alt={slide.title}
                    class="h-full w-full object-cover opacity-70"
                    loading="lazy"
                  />

                  <!-- Botón para reproducir el video -->
                  <button
                    type="button"
                    data-play-video
                    aria-label={`${t.detail.playVideo} ${slide.title}`}
                    class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors duration-300 hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
                  >
                    <span
                      class="flex size-16 items-center justify-center rounded-full border border-white/25 bg-white/10 backdrop-blur-sm transition-transform duration-300 hover:scale-110"
                    >
                      <svg
                        class="ml-1 size-6 text-white"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M8 5v14l11-7Z" />
                      </svg>
                    </span>
                  </button>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>

    {
      hasMultiple && (
        <>
          <!-- Botón para mostrar la diapositiva anterior -->
          <button
            type="button"
            data-gallery-prev
            aria-label={t.detail.previousSlide}
            class="absolute top-1/2 left-2 z-20 flex h-14 w-8 -translate-y-1/2 cursor-pointer items-center justify-center text-zinc-300 drop-shadow-[0_0_8px_rgba(0,0,0,0.9)] transition-all duration-200 hover:text-(--project-accent) focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:outline-none sm:left-0 lg:-left-10 [&_svg]:h-10 [&_svg]:w-5"
          >
            <CarouselChevronLeft />
          </button>

          <!-- Botón para mostrar la siguiente diapositiva -->
          <button
            type="button"
            data-gallery-next
            aria-label={t.detail.nextSlide}
            class="absolute top-1/2 right-2 z-20 flex h-14 w-8 -translate-y-1/2 cursor-pointer items-center justify-center text-zinc-300 drop-shadow-[0_0_8px_rgba(0,0,0,0.9)] transition-all duration-200 hover:text-(--project-accent) focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:outline-none sm:right-0 lg:-right-10 [&_svg]:h-10 [&_svg]:w-5"
          >
            <CarouselChevronRight />
          </button>

          <!-- Contador de diapositivas -->
          <div
            class="absolute right-3 bottom-3 rounded-full border border-white/10 bg-zinc-950/70 px-2.5 py-1 font-mono text-[11px] text-zinc-300 tabular-nums backdrop-blur-sm"
            data-gallery-counter
            aria-live="polite"
          >
            1 / {slides.length}
          </div>
        </>
      )
    }
  </div>
</div>

<script>
  /* Busca la galería presente en la página */
  const gallery =
    document.querySelector<HTMLElement>("[data-gallery]");

  if (gallery) {
    /* Elementos principales del carrusel */
    const track =
      gallery.querySelector<HTMLElement>(
        "[data-gallery-track]",
      );

    const frame =
      gallery.querySelector<HTMLElement>(
        "[data-gallery-frame]",
      );

    const viewport =
      gallery.querySelector<HTMLElement>(
        "[data-gallery-viewport]",
      );

    const slides = Array.from(
      gallery.querySelectorAll<HTMLElement>(
        "[data-gallery-slide]",
      ),
    );

    const prevBtn =
      gallery.querySelector<HTMLButtonElement>(
        "[data-gallery-prev]",
      );

    const nextBtn =
      gallery.querySelector<HTMLButtonElement>(
        "[data-gallery-next]",
      );

    const counter =
      gallery.querySelector<HTMLElement>(
        "[data-gallery-counter]",
      );

    /* Estado actual de la galería */
    const total = slides.length;
    let current = 0;

    /* Actualiza la posición y el contador */
    function render() {
      if (track) {
        track.style.transform =
          `translateX(-${current * 100}%)`;
      }

      if (counter) {
        counter.textContent =
          `${current + 1} / ${total}`;
      }
    }

    /* Navega hacia una diapositiva específica */
    function goTo(index: number) {
      current = (index + total) % total;
      render();
    }

    /* Navegación mediante botones */
    prevBtn?.addEventListener(
      "click",
      () => goTo(current - 1),
    );

    nextBtn?.addEventListener(
      "click",
      () => goTo(current + 1),
    );

    /* Navegación mediante teclado */
    frame?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        goTo(current - 1);
      }

      if (event.key === "ArrowRight") {
        goTo(current + 1);
      }
    });

    /* Posición inicial del gesto táctil */
    let touchStartX = 0;

    /* Registra el inicio del deslizamiento */
    viewport?.addEventListener(
      "touchstart",
      (event) => {
        touchStartX =
          event.touches[0].clientX;
      },
      { passive: true },
    );

    /* Cambia de diapositiva al finalizar el gesto */
    viewport?.addEventListener(
      "touchend",
      (event) => {
        const delta =
          event.changedTouches[0].clientX -
          touchStartX;

        if (Math.abs(delta) > 40) {
          goTo(
            current +
              (delta < 0 ? 1 : -1),
          );
        }
      },
      { passive: true },
    );

    /* Inicializa los videos cuando se presiona reproducir */
    gallery
      .querySelectorAll<HTMLButtonElement>(
        "[data-play-video]",
      )
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const slot =
            btn.closest<HTMLElement>(
              "[data-youtube-slot]",
            );

          if (!slot) return;

          const videoId =
            slot.dataset.videoId;

          const title =
            slot.dataset.videoTitle ??
            gallery.dataset.fallbackVideoTitle ??
            "";

          /* Crea el reproductor de YouTube */
          const iframe =
            document.createElement("iframe");

          iframe.src =
            `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;

          iframe.title = title;

          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";

          iframe.allowFullscreen = true;
          iframe.className = "h-full w-full";

          /* Sustituye la miniatura por el reproductor */
          slot.replaceChildren(iframe);
        });
      });
  }
</script>