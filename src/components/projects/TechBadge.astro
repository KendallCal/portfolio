---
/* Tipo de tecnología recibido por el componente */
import type { Tech } from "../../data/projects";

/* Iconos disponibles para las tecnologías */
import AWSIcon from "../icons/AWS.astro";
import AstroIcon from "../icons/Astro.astro";
import BankersAlgorithmIcon from "../icons/BankersAlgorithm.astro";
import CSharpIcon from "../icons/CSharp.astro";
import FastAPIIcon from "../icons/FastAPI.astro";
import FlutterIcon from "../icons/Flutter.astro";
import JavaIcon from "../icons/Java.astro";
import JavaScriptIcon from "../icons/JavaScript.astro";
import NetIcon from "../icons/Net.astro";
import NetBeansIcon from "../icons/NetBeans.astro";
import NextJSIcon from "../icons/NextJS.astro";
import NetworkIcon from "../icons/Network.astro";
import NodeJSIcon from "../icons/NodeJS.astro";
import PythonIcon from "../icons/Python.astro";
import PostgreSQLIcon from "../icons/PostgreSQL.astro";
import SQLServerIcon from "../icons/SQLServer.astro";
import SupabaseIcon from "../icons/Supabase.astro";
import TailwindCssIcon from "../icons/TailwindCss.astro";
import TypeScriptIcon from "../icons/TypeScript.astro";

/* Propiedades que recibe el componente */
interface Props {
  tech: Tech;
}

/* Tecnología actual */
const { tech } = Astro.props;

/* Relación entre cada nombre de icono y su componente */
const iconMap = {
  aws: AWSIcon,
  astro: AstroIcon,
  bankersalgorithm: BankersAlgorithmIcon,
  csharp: CSharpIcon,
  dotnet: NetIcon,
  fastapi: FastAPIIcon,
  flutter: FlutterIcon,
  java: JavaIcon,
  javascript: JavaScriptIcon,
  javaswing: JavaIcon,
  netbeans: NetBeansIcon,
  nextjs: NextJSIcon,
  nodejs: NodeJSIcon,
  python: PythonIcon,
  postgresql: PostgreSQLIcon,
  sqlserver: SQLServerIcon,
  supabase: SupabaseIcon,
  tailwindcss: TailwindCssIcon,
  tcpip: NetworkIcon,
  typescript: TypeScriptIcon,
} as const;

/* Normaliza el nombre para buscar el icono correspondiente */
const normalizedIcon = tech.icon
  .toLowerCase()
  .replace(/[^a-z0-9]/g, "");

/* Selecciona el icono de la tecnología */
const TechIcon =
  iconMap[normalizedIcon as keyof typeof iconMap];
---

<!-- Tecnología utilizada por el proyecto -->
<span
  class="tech-item inline-flex h-5 w-22 items-center justify-center gap-1.5 text-[0.6875rem] leading-none font-medium text-zinc-400 transition-colors duration-200"
  title={tech.name}
>
  {
    TechIcon ? (
      <span
        class="inline-flex size-3.5 shrink-0 items-center justify-center text-zinc-500 transition-colors duration-200 [&_svg]:size-3.5"
        aria-hidden="true"
      >
        <TechIcon />
      </span>
    ) : (
      <span
        class="text-[0.5625rem] text-zinc-500"
        aria-hidden="true"
      >
        {tech.name.slice(0, 2).toUpperCase()}
      </span>
    )
  }

  <!-- Nombre de la tecnología -->
  <span>{tech.name}</span>
</span>

<style>
  /* Resalta el nombre al pasar el cursor */
  .tech-item:hover {
    color: rgb(228 228 231);
  }

  /* Aplica el color del proyecto al icono */
  .tech-item:hover > :first-child {
    color: var(--project-accent, rgb(56 189 248));
  }
</style>
