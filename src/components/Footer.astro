---
/* Sistema de idiomas y rutas localizadas */
import type { Language } from "../i18n/config";
import { getTranslations, localizePath } from "../i18n/utils";

/* Propiedades que puede recibir el componente */
interface Props {
  language?: Language;
}

/* Idioma actual y traducciones correspondientes */
const { language = "es" } = Astro.props;
const t = getTranslations(language);

/* Enlaces principales mostrados en el pie de página */
const navLinks = [
  {
    label: t.header.links.projects,
    href: localizePath("/projects", language),
  },
  {
    label: t.header.links.experience,
    href: `${localizePath("/", language)}#experience`,
  },
  {
    label: t.header.links.about,
    href: localizePath("/about", language),
  },
  {
    label: t.header.links.contact,
    href: localizePath("/contact", language),
  },
] as const;
---

<footer class="w-full px-6 pt-4 pb-5">
  <div
    class="mx-auto flex min-h-14 max-w-6xl items-center justify-between rounded-xl border border-zinc-800/80 bg-transparent px-4"
  >
    <!-- Correo mostrado en dispositivos móviles -->
    <a
      href="mailto:kendallcr2012@gmail.com"
      class="text-sm font-normal text-zinc-300 transition-colors duration-200 hover:text-white sm:hidden"
    >
      kendallcr2012@gmail.com
    </a>

    <!-- Nombre mostrado en pantallas medianas y grandes -->
    <span class="hidden text-sm font-normal text-zinc-300 sm:inline">
      Kendall Calderón
    </span>

    <!-- Navegación del pie de página -->
    <nav class="hidden items-center gap-6 sm:flex" aria-label={t.footer.nav}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-normal text-zinc-400 transition-colors duration-200 hover:text-sky-400"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  /* Ajustes del pie de página en dispositivos pequeños */
  @media (max-width: 560px) {
    footer {
      padding-inline: 1rem;
    }

    footer > div {
      justify-content: center;
    }
  }
</style>
