---
const navLinks = [
  { label: "Proyectos", href: "/projects" },
  { label: "Experiencia", href: "/#experience" },
  { label: "Sobre mí", href: "/about" },
  { label: "Contacto", href: "/contact" },
] as const;
---

<footer class="w-full px-6 pb-5 pt-4">
  <div class="mx-auto flex min-h-14 max-w-6xl items-center justify-between rounded-xl border border-zinc-800/80 bg-transparent px-4">
    <a
      href="mailto:kendallcr2012@gmail.com"
      class="text-sm font-normal text-zinc-300 transition-colors duration-200 hover:text-white sm:hidden"
    >
      kendallcr2012@gmail.com
    </a>

    <span class="hidden text-sm font-normal text-zinc-300 sm:inline">Kendall Calderón</span>

    <nav class="hidden items-center gap-6 sm:flex" aria-label="Navegación del pie de página">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-normal text-zinc-400 transition-colors duration-200 hover:text-sky-400"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  @media (max-width: 560px) {
    footer {
      padding-inline: 1rem;
    }

    footer > div {
      justify-content: center;
    }
  }
</style>
