---
// @ts-ignore: side-effect font import without types
import '@fontsource-variable/onest';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	showFooter?: boolean;
}

const { title = "Kendall Calderón — Portfolio", showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="pointer-events-none fixed inset-0 z-[-2] min-h-screen w-full bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
		<Header />
		<slot />
		{showFooter && <Footer />}
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
	}

	html {
		font-family: "Onest Variable", system-ui, -apple-system, sans-serif;
		margin: 0;
		width: 100%;
		overflow-x: clip;
	}

	body {
		background-color: #050505;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;
		margin: 0;
		width: 100%;
		overflow-x: clip;
	}

</style>
