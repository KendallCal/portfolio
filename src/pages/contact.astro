---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";

const email = "kendallcr2012@gmail.com";
const whatsappNumber = "50684919253";
const whatsappMessage = encodeURIComponent("Hola Kendall, vi tu portafolio y me gustaría conversar sobre una oportunidad.");
---

<Layout title="Contacto — Kendall Calderón">
  <main class="mx-auto w-full max-w-5xl flex-1 px-6 pb-24 pt-3" data-contact-page>
    <header class="border-b border-zinc-800/80 pb-12">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-sky-400">Hablemos</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">Contacto</h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-zinc-400 sm:text-lg">
        Si tenés un proyecto, una oportunidad o una consulta, escribime por correo o conversemos directamente por WhatsApp.
      </p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
      <section aria-labelledby="contact-email-title">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center text-sky-400">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
            </svg>
          </span>
          <div>
            <h2 id="contact-email-title" class="text-xl font-semibold text-white">Enviar un correo</h2>
            <p class="mt-1 text-sm leading-6 text-zinc-500">El formulario abrirá tu aplicación de correo con el mensaje preparado.</p>
          </div>
        </div>

        <form class="mt-7 space-y-5 border-y border-zinc-800/80 py-6" data-email-form>
          <div>
            <label for="contact-email" class="mb-2 block text-sm font-medium text-zinc-300">Tu correo</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="nombre@correo.com"
              class="w-full border-0 border-b border-zinc-800 bg-transparent px-0 py-3 text-sm text-zinc-200 placeholder:text-zinc-600 transition-colors focus:border-sky-400 focus:outline-none focus:ring-0"
            />
          </div>

          <div>
            <label for="contact-subject" class="mb-2 block text-sm font-medium text-zinc-300">Asunto</label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              required
              maxlength="120"
              placeholder="¿En qué puedo ayudarte?"
              class="w-full border-0 border-b border-zinc-800 bg-transparent px-0 py-3 text-sm text-zinc-200 placeholder:text-zinc-600 transition-colors focus:border-sky-400 focus:outline-none focus:ring-0"
            />
          </div>

          <div>
            <label for="contact-message" class="mb-2 block text-sm font-medium text-zinc-300">Mensaje</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="7"
              maxlength="2000"
              placeholder="Contame un poco sobre tu proyecto, necesidad u oportunidad..."
              class="w-full resize-y border-0 border-b border-zinc-800 bg-transparent px-0 py-3 text-sm leading-6 text-zinc-200 placeholder:text-zinc-600 transition-colors focus:border-sky-400 focus:outline-none focus:ring-0"
            ></textarea>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs leading-5 text-zinc-600">No se almacena ninguna información en este sitio.</p>
            <button
              type="submit"
              class="group inline-flex h-11 items-center justify-center gap-2.5 rounded-full border border-sky-400/30 bg-sky-400/10 px-6 text-sm font-semibold text-sky-300 transition-all duration-300 hover:border-sky-400 hover:bg-sky-400 hover:text-zinc-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 active:scale-[0.97] motion-reduce:transition-none"
            >
              Enviar correo
              <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4 4 17 8-17 8 3-8-3-8Z" /><path d="M7 12h14" />
              </svg>
            </button>
          </div>
        </form>
      </section>

      <aside class="space-y-10 lg:border-l lg:border-zinc-800/80 lg:pl-8">
        <section aria-labelledby="contact-whatsapp-title">
          <span class="flex size-8 items-center justify-center text-emerald-400">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.2 7.8c.3-.3.7-.2.9.1l1 2c.1.3.1.5-.1.7l-.7.8c.8 1.5 1.9 2.6 3.5 3.4l.8-.9c.2-.2.5-.2.7-.1l1.9.9c.4.2.5.6.3.9-.6 1-1.6 1.4-2.7 1.2-3.7-.8-6.6-3.7-7.4-7.3-.2-.7.1-1.3.6-1.7" />
            </svg>
          </span>
          <h2 id="contact-whatsapp-title" class="mt-4 text-base font-semibold text-white">WhatsApp</h2>
          <p class="mt-2 text-sm leading-6 text-zinc-500">Para una conversación rápida y directa.</p>
          <a
            href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex items-center gap-2 border-b border-emerald-400/30 pb-1 text-sm font-medium text-emerald-300 transition-colors hover:border-emerald-400 hover:text-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
          >
            Escribir por WhatsApp
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5" /></svg>
          </a>
        </section>

        <section class="border-t border-zinc-800/80 pt-8" aria-labelledby="contact-direct-title">
          <h2 id="contact-direct-title" class="text-sm font-semibold text-zinc-200">Contacto directo</h2>
          <a href={`mailto:${email}`} class="mt-3 block break-all text-sm text-zinc-500 transition-colors hover:text-sky-400">{email}</a>
          <p class="mt-2 font-mono text-xs text-zinc-600">+506 8491 9253</p>
        </section>

        <p class="border-t border-zinc-800/80 pt-8 text-xs leading-5 text-zinc-600">Normalmente respondo tan pronto como me es posible.</p>
      </aside>
    </div>
  </main>
</Layout>

<script define:vars={{ email }}>
  const emailForm = document.querySelector<HTMLFormElement>("[data-email-form]");

  emailForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!emailForm.reportValidity()) return;

    const formData = new FormData(emailForm);
    const senderEmail = String(formData.get("email") ?? "").trim();
    const subject = String(formData.get("subject") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();
    const body = `${message}\n\nCorreo de contacto: ${senderEmail}`;

    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
