---
/* Estilos generales del sitio */
import "../styles/global.css";

/* Layout principal */
import Layout from "../layouts/Layout.astro";

/* Sistema de idiomas */
import type { Language } from "../i18n/config";
import { getTranslations } from "../i18n/utils";

/* Propiedades que puede recibir la página */
interface Props {
  language?: Language;
}

/* Idioma actual y traducciones correspondientes */
const { language = "es" } = Astro.props;
const t = getTranslations(language);

/* Datos de contacto */
const email = "kendallcr2012@gmail.com";
const whatsappNumber = "50684919253";

/*
 * Codifica los textos para que puedan enviarse correctamente dentro de las URL de WhatsApp y correo electrónico.
 */
const whatsappMessage = encodeURIComponent(t.contact.whatsappMessage);
const emailSubject = encodeURIComponent(t.contact.emailSubject);
---

<Layout title={t.metadata.contact} language={language}>
  <main
    class="mx-auto flex min-h-[calc(100svh-4.5625rem)] w-full max-w-4xl flex-1 flex-col justify-center px-4 py-8 sm:px-6 sm:py-10"
    data-contact-page
  >
    <!-- Encabezado de la página -->
    <header class="border-b border-zinc-800/80 pb-8">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-sky-400">
        {t.contact.eyebrow}
      </p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-5xl">
        {t.contact.title}
      </h1>

      <p class="mt-4 w-full text-base leading-7 text-zinc-400">
        {t.contact.introduction}
      </p>
    </header>

    <!-- Métodos de contacto -->
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <!-- Contacto por correo electrónico -->
      <a
        href={`mailto:${email}?subject=${emailSubject}`}
        class="group flex min-h-44 flex-col gap-4 rounded-2xl border border-zinc-800/80 bg-zinc-900/30 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/40 hover:bg-zinc-900/60 hover:shadow-lg hover:shadow-sky-400/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 sm:p-6"
      >
        <span
          class="flex size-11 items-center justify-center rounded-full bg-sky-400/10 text-sky-400 transition-colors duration-300 group-hover:bg-sky-400/15"
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m4 7 8 6 8-6"
            />
          </svg>
        </span>

        <div>
          <h2 class="text-lg font-semibold text-white">
            {t.contact.email}
          </h2>

          <p class="mt-1 break-all text-sm text-zinc-500">
            {email}
          </p>
        </div>

        <span
          class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-sky-300 transition-colors duration-300 group-hover:text-sky-400"
        >
          {t.contact.sendEmail}

          <svg
            class="size-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m-5-5 5 5-5 5"
            />
          </svg>
        </span>
      </a>

      <!-- Contacto por WhatsApp -->
      <a
        href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex min-h-44 flex-col gap-4 rounded-2xl border border-zinc-800/80 bg-zinc-900/30 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-emerald-400/40 hover:bg-zinc-900/60 hover:shadow-lg hover:shadow-emerald-400/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 sm:p-6"
      >
        <span
          class="flex size-11 items-center justify-center rounded-full bg-emerald-400/10 text-emerald-400 transition-colors duration-300 group-hover:bg-emerald-400/15"
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6Z"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.2 7.8c.3-.3.7-.2.9.1l1 2c.1.3.1.5-.1.7l-.7.8c.8 1.5 1.9 2.6 3.5 3.4l.8-.9c.2-.2.5-.2.7-.1l1.9.9c.4.2.5.6.3.9-.6 1-1.6 1.4-2.7 1.2-3.7-.8-6.6-3.7-7.4-7.3-.2-.7.1-1.3.6-1.7"
            />
          </svg>
        </span>

        <div>
          <h2 class="text-lg font-semibold text-white">
            {t.contact.whatsapp}
          </h2>

          <p class="mt-1 font-mono text-sm text-zinc-500">
            +506 8491 9253
          </p>
        </div>

        <span
          class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-emerald-300 transition-colors duration-300 group-hover:text-emerald-400"
        >
          {t.contact.sendWhatsapp}

          <svg
            class="size-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m-5-5 5 5-5 5"
            />
          </svg>
        </span>
      </a>
    </div>

    <!-- Tiempo estimado de respuesta -->
    <p class="mt-6 text-sm text-zinc-600">
      {t.contact.response}
    </p>
  </main>
</Layout>