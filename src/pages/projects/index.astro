---
import "../../styles/global.css";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import { projects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";

const categoryLabels: Record<string, string> = {
  mobile: "Móvil",
  ai: "Inteligencia artificial",
  web: "Web",
};

const categories = [...new Set(projects.map((project) => project.category))].map((value) => ({
  value,
  label: categoryLabels[value] ?? value,
}));
---

<Layout title="Proyectos — Kendall Calderón">
  <main data-project-catalog class="mx-auto w-full max-w-6xl flex-1 px-6 pb-24 pt-3 sm:pt-5">
    <header class="mx-auto max-w-5xl text-center">
      <h1 class="projects-title text-3xl font-bold tracking-tight sm:text-4xl">
        Proyectos
      </h1>

      <p class="mx-auto mt-2 max-w-3xl text-sm leading-6 text-zinc-400 sm:text-base">
        Una selección de proyectos personales que reflejan mi forma de aprender, resolver problemas y construir con tecnología.
      </p>
    </header>

    {projects.length > 0 ? (
      <>
        <div class="-mx-6 mt-8 overflow-x-auto px-6 sm:mx-0 sm:flex sm:justify-center sm:px-0">
          <div
            class="inline-flex min-w-max items-center gap-3"
            data-project-filters
            role="group"
            aria-label="Filtrar proyectos por categoría"
          >
            <button type="button" data-filter="all" class="filter-tab is-active" aria-pressed="true">
              Todos
            </button>
            {categories.map((category) => (
              <>
                <span class="font-mono text-xs text-sky-400/70" aria-hidden="true">/</span>
                <button type="button" data-filter={category.value} class="filter-tab" aria-pressed="false">
                  {category.label}
                </button>
              </>
            ))}
          </div>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
          {projects.map((project, index) => (
            <div data-project-item data-category={project.category}>
              <ProjectCard project={project} index={index} />
            </div>
          ))}
        </div>

        <p class="mt-12 hidden text-center text-sm text-zinc-500" data-empty-message>
          No hay proyectos en esta categoría todavía.
        </p>
      </>
    ) : (
      <div class="mt-12 flex flex-col items-center gap-3 rounded-2xl border border-dashed border-zinc-800 py-20 text-center">
        <span class="font-mono text-2xl text-zinc-700" aria-hidden="true">{"</>"}</span>
        <p class="text-sm text-zinc-500">Próximamente se publicarán nuevos proyectos.</p>
      </div>
    )}
  </main>
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-filters] [data-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-project-item]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-empty-message]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      filterButtons.forEach((b) => {
        const isActive = b === button;
        b.classList.toggle("is-active", isActive);
        b.setAttribute("aria-pressed", String(isActive));
      });

      let visibleCount = 0;
      items.forEach((item) => {
        const matches = filter === "all" || item.dataset.category === filter;
        item.classList.toggle("hidden", !matches);
        if (matches) visibleCount++;
      });

      emptyMessage?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>

<style>
  .projects-title {
    color: rgb(56 189 248);
    animation: projects-title-glow 8s ease-in-out infinite;
  }

  @keyframes projects-title-glow {
    0%,
    100% {
      color: rgb(56 189 248);
      text-shadow: 0 0 0 transparent;
    }

    50% {
      color: rgb(125 211 252);
      text-shadow: 0 0 12px rgb(56 189 248 / 0.28);
    }
  }

  .filter-tab {
    position: relative;
    padding: 0.45rem 0.15rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(113 113 122);
    transition: color 250ms ease;
  }

  .filter-tab::after {
    position: absolute;
    right: 18%;
    bottom: 0;
    left: 18%;
    height: 1px;
    content: "";
    background: rgb(56 189 248);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 250ms ease;
  }

  .filter-tab:hover {
    color: rgb(244 244 245);
  }

  .filter-tab:hover::after,
  .filter-tab.is-active::after {
    transform: scaleX(1);
  }

  .filter-tab.is-active {
    color: rgb(250 250 250);
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-title {
      animation: none;
    }

    .filter-tab,
    .filter-tab::after {
      transition: none;
    }
  }
</style>
