---
import "../../styles/global.css";
import GitHubIcon from "../../components/icons/GitHub.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import ProjectTechnology from "../../components/projects/ProjectTechnology.astro";
import { projects, type Project, type ProjectPlatform } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectIndex = projects.findIndex(({ slug }) => slug === project.slug);
const nextProject = projects.length > 1
  ? projects[(projectIndex + 1) % projects.length]
  : undefined;

const statusMap = {
  completed: { label: "Completado", dotClass: "bg-emerald-400" },
  "in-progress": { label: "En desarrollo", dotClass: "bg-amber-400" },
  archived: { label: "Archivado", dotClass: "bg-zinc-500" },
} as const;

const platformMap: Record<ProjectPlatform, { label: string; icon: "browser" | "mobile" | "desktop" }> = {
  web: { label: "Web", icon: "browser" },
  android: { label: "Android", icon: "mobile" },
  ios: { label: "iOS", icon: "mobile" },
  desktop: { label: "Escritorio", icon: "desktop" },
};

const platformSummary = project.platforms.map((platform) => platformMap[platform].label).join(" y ");
const status = statusMap[project.status];
const isAvailableUrl = (url?: string) => Boolean(url && !/(?:tu-usuario|tu-dominio)/i.test(url));
const liveUrl = isAvailableUrl(project.liveUrl) ? project.liveUrl : undefined;
const repoUrl = isAvailableUrl(project.repoUrl) ? project.repoUrl : undefined;
---

<Layout title={`${project.title} — Proyectos`}>
  <main class="mx-auto w-full max-w-6xl flex-1 px-6 pb-24 pt-16 sm:pt-20">
    <header class="mx-auto max-w-4xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">{project.title}</h1>
      <p class="mx-auto mt-5 max-w-3xl text-sm leading-7 text-zinc-400 sm:text-base sm:leading-8">
        {project.fullDesc}
      </p>

      {(repoUrl || liveUrl) && (
        <div class="mt-8 flex flex-col items-center gap-3" aria-label="Enlaces del proyecto">
          {repoUrl && (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex h-11 items-center gap-2.5 rounded-full border border-zinc-700/80 bg-transparent px-6 text-sm font-semibold text-zinc-300 transition-all duration-300 ease-out hover:border-sky-400/60 hover:text-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 active:scale-[0.97] motion-reduce:transition-none motion-reduce:active:scale-100"
            >
              <GitHubIcon class="size-4" />
              Ver repositorio
            </a>
          )}

          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="
                group
                inline-flex
                h-11
                items-center
                gap-2.5
                rounded-full
                border border-sky-400/30
                bg-sky-400/10
                px-6
                text-sm
                font-semibold
                text-sky-300
                shadow-sm
                shadow-black/20
                transition-all
                duration-300
                ease-out
                hover:border-sky-400
                hover:bg-sky-400
                hover:text-zinc-950
                hover:shadow-lg
                hover:shadow-sky-400/25
                focus-visible:outline-none
                focus-visible:ring-2
                focus-visible:ring-sky-400
                focus-visible:ring-offset-2
                focus-visible:ring-offset-zinc-950
                active:scale-[0.97]
                motion-reduce:transition-none
                motion-reduce:active:scale-100
              "
            >
              Ver proyecto
              <svg class="size-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6m0-6L10 14" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              </svg>
            </a>
          )}
        </div>
      )}
    </header>

    <div class="mt-12 sm:mt-14">
      <ProjectGallery title={project.title} image={project.image} media={project.media} />
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
      <section aria-labelledby="project-features-title">
        <p class="text-xs font-medium uppercase tracking-[0.16em] text-sky-400">La solución</p>
        <h2 id="project-features-title" class="mt-3 text-2xl font-semibold tracking-tight text-white">Lo que ofrece</h2>

        {project.features && project.features.length > 0 ? (
          <ul class="mt-6 divide-y divide-zinc-800/70 border-y border-zinc-800/70">
            {project.features.map((feature, index) => (
              <li class="grid grid-cols-[1.75rem_1fr] gap-3 py-4 text-sm leading-6 text-zinc-400 sm:text-base sm:leading-7">
                <span class="pt-0.5 text-xs font-medium tabular-nums text-sky-400" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-5 text-sm leading-7 text-zinc-400">El alcance funcional se encuentra en desarrollo.</p>
        )}
      </section>

      <aside class="h-fit border-t border-zinc-800/80 pt-8 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0" aria-labelledby="project-information-title">
        <h2 id="project-information-title" class="text-base font-semibold text-white">Información</h2>

        <dl class="mt-5 space-y-5">
          <div>
            <dt class="text-xs uppercase tracking-[0.12em] text-zinc-600">Estado</dt>
            <dd class="mt-2 inline-flex items-center gap-2 text-sm text-zinc-300">
              <span class:list={["size-1.5 rounded-full", status.dotClass]} aria-hidden="true"></span>
              {status.label}
            </dd>
          </div>

          <div>
            <dt class="text-xs uppercase tracking-[0.12em] text-zinc-600">Plataforma</dt>
            <dd class="mt-2 flex flex-wrap gap-3" aria-label={`Plataformas: ${platformSummary}`}>
              {project.platforms.map((platform) => {
                const item = platformMap[platform];
                return (
                  <span class="inline-flex items-center gap-1.5 text-sm text-zinc-300">
                    {item.icon === "browser" ? (
                      <svg class="size-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M3 8h18" /><path d="M7 6h.01" />
                      </svg>
                    ) : item.icon === "mobile" ? (
                      <svg class="size-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />
                      </svg>
                    ) : (
                      <svg class="size-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
                      </svg>
                    )}
                    {item.label}
                  </span>
                );
              })}
            </dd>
          </div>

          <div>
            <dt class="text-xs uppercase tracking-[0.12em] text-zinc-600">Disponibilidad</dt>
            <dd class="mt-2 text-sm leading-6 text-zinc-300">
              {liveUrl ? "Producto público" : "Demo no pública"}
              <span class="text-zinc-600"> · </span>
              {repoUrl ? "Código disponible" : "Código privado"}
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    {project.techs.length > 0 && (
      <section class="mx-auto mt-14 max-w-4xl border-t border-zinc-800/80 pt-8" aria-labelledby="project-technologies-title">
        <h2 id="project-technologies-title" class="text-base font-semibold text-white">Tecnologías</h2>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-4">
          {project.techs.map((tech) => (
            <li>
              <ProjectTechnology tech={tech} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="mx-auto mt-16 grid max-w-4xl gap-3 border-t border-zinc-800/80 pt-6 sm:grid-cols-2" aria-label="Navegación entre proyectos">
      <a href="/projects" class="group rounded-xl border border-transparent p-4 transition-colors duration-200 hover:border-zinc-800 hover:bg-zinc-900/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/60">
        <span class="text-xs text-zinc-500">Explorar</span>
        <span class="mt-1 flex items-center gap-2 text-sm font-medium text-zinc-200 transition-colors group-hover:text-sky-400">
          <svg class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5 motion-reduce:transform-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16l-4-4m0 0 4-4m-4 4h18" />
          </svg>
          Todos los proyectos
        </span>
      </a>

      {nextProject && (
        <a href={`/projects/${nextProject.slug}`} class="group rounded-xl border border-transparent p-4 text-right transition-colors duration-200 hover:border-zinc-800 hover:bg-zinc-900/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/60">
          <span class="text-xs text-zinc-500">Siguiente proyecto</span>
          <span class="mt-1 flex items-center justify-end gap-2 text-sm font-medium text-zinc-200 transition-colors group-hover:text-sky-400">
            {nextProject.title}
            <svg class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transform-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 8l4 4m0 0-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      )}
    </nav>
  </main>
</Layout>
