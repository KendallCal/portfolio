---
import "../styles/global.css";
import AboutMe from "../components/AboutMe.astro";
import Experience from "../components/Experience.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/projects/ProjectGrid.astro";
import Stack from "../components/Stack.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="overflow-x-clip px-4">
    <Hero />

    <div
      class="mx-auto flex w-full flex-col gap-20 pt-20 pb-14 sm:gap-24 sm:pt-24 sm:pb-20 lg:w-185 lg:gap-[7.5rem] lg:pt-[7.5rem]"
    >
      <div data-reveal-section>
        <ProjectGrid />
      </div>
      <div data-reveal-section>
        <Experience />
      </div>
      <div data-reveal-section>
        <AboutMe />
      </div>
      <div data-reveal-section>
        <Stack />
      </div>
    </div>
  </main>
</Layout>

<style>
  :global(.reveal-sections [data-reveal-section]) {
    opacity: 0;
    filter: blur(5px);
    transform: translateY(2rem);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.reveal-sections [data-reveal-section].is-visible) {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.reveal-sections [data-reveal-section]) {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const revealSections = document.querySelectorAll<HTMLElement>(
    "[data-reveal-section]",
  );

  if (reducedMotion || !("IntersectionObserver" in window)) {
    revealSections.forEach((section) => section.classList.add("is-visible"));
  } else {
    document.documentElement.classList.add("reveal-sections");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -64px",
      },
    );

    revealSections.forEach((section) => observer.observe(section));
  }
</script>
