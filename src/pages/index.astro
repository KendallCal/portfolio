</Layout>

<script>
  // ============================================================
  // Signature element: terminal typewriter para el rol del hero
  // Escribe y borra cada rol de la lista, como un prompt de consola.
  // Términos que ya son de uso estándar en inglés dentro del gremio
  // (Cloud, Backend, Frontend) se dejan en inglés; el resto en español.
  // ============================================================
  const ROLES = [
    "Ingeniero Informático",
    "Desarrollador de Software",
    "Cloud & Inteligencia Artificial",
  ] as const;

  const TYPE_SPEED_MS = 55;
  const DELETE_SPEED_MS = 30;
  const HOLD_MS = 1800; // tiempo que se queda el texto completo antes de borrar

  const roleEl = document.getElementById("role-text");

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  async function typeText(text: string): Promise<void> {
    if (!roleEl) return;
    for (let i = 0; i <= text.length; i++) {
      roleEl.textContent = text.slice(0, i);
      await wait(TYPE_SPEED_MS);
    }
  }

  async function deleteText(text: string): Promise<void> {
    if (!roleEl) return;
    for (let i = text.length; i >= 0; i--) {
      roleEl.textContent = text.slice(0, i);
      await wait(DELETE_SPEED_MS);
    }
  }

  function wait(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function runTypewriterLoop(): Promise<void> {
    if (!roleEl) return;

    if (prefersReducedMotion()) {
      roleEl.textContent = ROLES[0];
      return;
    }

    let index = 0;
    // eslint-disable-next-line no-constant-condition
    while (true) {
      const role = ROLES[index % ROLES.length];
      await typeText(role);
      await wait(HOLD_MS);
      await deleteText(role);
      index++;
    }
  }

  runTypewriterLoop();
</script>
